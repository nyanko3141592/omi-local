<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>me.omi-local.sync</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string>
    <string>cd ~/Dev/omi-local &amp;&amp; .venv/bin/python -m omi_local.pull &amp;&amp; .venv/bin/python -m omi_local.transcribe</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>/tmp/omi-local.log</string>
  <key>StandardErrorPath</key><string>/tmp/omi-local.log</string>
</dict></plist>
