<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>me.omi-local.watch</string>
  <key>ProgramArguments</key><array>
    <string>__REPO__/.venv/bin/python</string><string>-m</string><string>omi_local.watch</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key><dict><key>OMI_DATA_DIR</key><string>__DATA__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DATA__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__DATA__/logs/launchd.err.log</string>
</dict></plist>
